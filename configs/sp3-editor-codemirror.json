{
  "name": "speedometer3-editor-codemirror",
  "description": "Speedometer 3 Editor-CodeMirror suite",
  "unit": "runs/min",
  "higher_is_better": true,
  "command": ["run-speedometer", "--suite", "Editor-CodeMirror"],
  "browsers": ["firefox", "chrome"],
  "binary": {"type": "arg", "flag": "--firefox"},
  "binary_by_browser": {"chrome": {"type": "arg", "flag": "--chrome"}},
  "modes": {
    "profile": {
      "command": ["run-speedometer", "--suite", "Editor-CodeMirror"]
    }
  }
}
