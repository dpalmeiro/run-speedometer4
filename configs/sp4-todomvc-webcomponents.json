{
  "name": "speedometer4-todomvc-webcomponents",
  "description": "Speedometer 4 TodoMVC-WebComponents suite",
  "unit": "runs/min",
  "higher_is_better": true,
  "command": ["run-speedometer4", "--suite", "TodoMVC-WebComponents"],
  "browsers": ["firefox", "chrome"],
  "binary": {"type": "arg", "flag": "--firefox"},
  "binary_by_browser": {"chrome": {"type": "arg", "flag": "--chrome"}},
  "modes": {
    "profile": {
      "command": ["run-speedometer4", "--suite", "TodoMVC-WebComponents"]
    }
  }
}
